# .env de PROD (atb). Vive só em /srv/airflow/.env, fora do git e fora do rsync
# do deploy (deploy_prod.sh não o sobrescreve). O Astro injeta em todos os containers.
ENV=prod

# ── Interpolação do docker-compose.override.yml (lidas pelo start.sh) ──
# REGRA DE OURO do homelab: o Docker ignora o UFW. Nunca 0.0.0.0.
BIND_IP=100.82.7.107
AIRFLOW_PORT=8080

# Fixa, senão a sessão da UI quebra a cada restart. openssl rand -hex 32
AIRFLOW__API__SECRET_KEY=

# Lake = buckets do SeaweedFS montados em /srv/lake/buckets; seeds do my_analytics na imagem.
LAKE_ROOT=/usr/local/airflow/mylake
SEEDS_ROOT=/usr/local/airflow/dbt/my_analytics/seeds

# Postgres de destino: container postgres-dwh na rede homelab-net.
DB__PROD__HOST=postgres-dwh
DB__PROD__PORT=5432
DB__PROD__NAME=analytics_prod
DB__PROD__USER=
DB__PROD__PASSWORD=

# Connection postgres_dw (Cosmos e include/utils): MESMO banco do perfil acima.
# Senha com caractere especial vai URL-encoded.
AIRFLOW_CONN_POSTGRES_DW=postgresql://<usuario>:<senha>@postgres-dwh:5432/analytics_prod
# HttpSensor do weather_etl (em dev vem do airflow_settings.yaml, que não vai para prod)
AIRFLOW_CONN_OPENWEATHER_CONN={"conn_type":"http","host":"https://api.openweathermap.org"}

# Pipeline energia/solar — portal apsystemsema.com
APSYSTEMS_USER=
APSYSTEMS_PASSWORD=

# Pipeline clima/openweather — One Call 3.0
OPENWEATHER_API_KEY=

# Selenium do próprio projeto (serviço selenium do override de prod)
SELENIUM_REMOTE_URL=http://selenium:4444/wd/hub

DISABLE_PANDERA_IMPORT_WARNING=True
AIRFLOW__CORE__DAGBAG_IMPORT_TIMEOUT=60
