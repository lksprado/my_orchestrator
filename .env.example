# Copie para .env e preencha. O .env NUNCA vai para o git nem para a imagem
# (.gitignore e .dockerignore). O Astro injeta este arquivo em todos os
# containers; em prod (atb) o equivalente vive em /srv/airflow/.env
# (modelo: deploy/prod/.env.example).
#
# Ambiente: dev = esta máquina (CLI do my_ingestion e este Airflow; cargas no
# ingestion_sandbox, dbt no analytics_dev); prod = atb. Escolhe o bloco environments dos YAMLs do
# my_ingestion e o perfil DB__<ENV>__* abaixo.
ENV=dev

# Dentro do container o lake e os seeds do my_analytics ficam sempre nestes caminhos
# (ver docker-compose.override.yml em dev).
LAKE_ROOT=/usr/local/airflow/mylake
SEEDS_ROOT=/usr/local/airflow/dbt/my_analytics/seeds

# Postgres de destino das cargas raw (GenericETL e include/utils/db_interactors).
# Em dev tem que ser ingestion_sandbox; em prod é o mesmo banco da postgres_dw.
DB__DEV__HOST=host.docker.internal
DB__DEV__PORT=5435
DB__DEV__NAME=ingestion_sandbox
DB__DEV__USER=
DB__DEV__PASSWORD=
# Só no atb (ENV=prod); pode ficar vazio em dev.
DB__PROD__HOST=
DB__PROD__PORT=5432
DB__PROD__NAME=
DB__PROD__USER=
DB__PROD__PASSWORD=

# Connection postgres_dw: banco do dbt (Cosmos). Em dev é o analytics_dev, que
# recebe raw só por cópia (scripts/raw_copy.sh do my_ingestion); em prod é o
# mesmo banco do perfil DB__PROD__*. Variável de ambiente tem precedência sobre a connection
# gravada no banco do Airflow. Senha com caractere especial vai URL-encoded.
AIRFLOW_CONN_POSTGRES_DW=postgresql://<usuario>:<senha>@host.docker.internal:5435/analytics_dev

# Pipeline energia/solar — portal apsystemsema.com
APSYSTEMS_USER=
APSYSTEMS_PASSWORD=
APSYSTEMS_EQUIPMENT_ID=

# Pipeline clima/openweather — One Call 3.0
OPENWEATHER_API_KEY=
# Ponto do day_summary (graus decimais)
OPENWEATHER_LAT=
OPENWEATHER_LON=

# Selenium remoto (solar, fundos_imobiliarios): container selenium/standalone-chrome.
#   dev  → http://host.docker.internal:4444/wd/hub
#   prod → http://selenium:4444/wd/hub (rede homelab-net)
SELENIUM_REMOTE_URL=http://host.docker.internal:4444/wd/hub

# Pipeline financas/investimentos (google) — service account montada de ~/.secrets
GOOGLE_CREDENTIALS_FILE=/usr/local/airflow/.secrets/finances-py.json
URL_FINANCE__LUCAS_JESSICA=
URL_FINANCE__DEUSA=

DISABLE_PANDERA_IMPORT_WARNING=True
AIRFLOW__CORE__DAGBAG_IMPORT_TIMEOUT=60
